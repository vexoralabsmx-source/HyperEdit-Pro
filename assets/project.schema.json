{
  "$defs": {
    "ASC_CDL": {
      "description": "ASC Color Decision List (Slope, Offset, Power, Saturation).",
      "properties": {
        "slope": {
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "description": "RGB slope (multiplication)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Slope",
          "type": "array"
        },
        "offset": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "description": "RGB offset (addition)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Offset",
          "type": "array"
        },
        "power": {
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "description": "RGB power (gamma exponent)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Power",
          "type": "array"
        },
        "saturation": {
          "default": 1.0,
          "description": "Color saturation multiplier",
          "maximum": 4.0,
          "minimum": 0.0,
          "title": "Saturation",
          "type": "number"
        }
      },
      "title": "ASC_CDL",
      "type": "object"
    },
    "AnimatedProperty": {
      "description": "Dynamic property driven by keyframes.",
      "properties": {
        "property_name": {
          "description": "e.g. position_x, scale, opacity, volume",
          "title": "Property Name",
          "type": "string"
        },
        "base_value": {
          "default": 0.0,
          "title": "Base Value",
          "type": "number"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "property_name"
      ],
      "title": "AnimatedProperty",
      "type": "object"
    },
    "AudioCodec": {
      "enum": [
        "aac",
        "opus",
        "pcm_s16le",
        "pcm_s24le",
        "mp3",
        "copy"
      ],
      "title": "AudioCodec",
      "type": "string"
    },
    "AudioMixConfig": {
      "description": "Audio bus or track mixing configuration.",
      "properties": {
        "volume_db": {
          "default": 0.0,
          "description": "Track fader in dB",
          "maximum": 12.0,
          "minimum": -96.0,
          "title": "Volume Db",
          "type": "number"
        },
        "pan": {
          "default": 0.0,
          "description": "Stereo pan (-1.0 Left, 1.0 Right)",
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Pan",
          "type": "number"
        },
        "mute": {
          "default": false,
          "title": "Mute",
          "type": "boolean"
        },
        "solo": {
          "default": false,
          "title": "Solo",
          "type": "boolean"
        },
        "ducking": {
          "anyOf": [
            {
              "$ref": "#/$defs/DuckingConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "loudness_normalization": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoudnessTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        }
      },
      "title": "AudioMixConfig",
      "type": "object"
    },
    "AudioStreamInfo": {
      "description": "Detailed audio stream parameters probed via ffprobe.",
      "properties": {
        "index": {
          "default": 0,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "codec": {
          "description": "Audio codec identifier, e.g. aac, pcm_s16le, opus, mp3",
          "title": "Codec",
          "type": "string"
        },
        "sample_rate": {
          "default": 48000,
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "channels": {
          "default": 2,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "channel_layout": {
          "default": "stereo",
          "title": "Channel Layout",
          "type": "string"
        },
        "duration_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "bitrate_kbps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bitrate Kbps"
        }
      },
      "required": [
        "codec"
      ],
      "title": "AudioStreamInfo",
      "type": "object"
    },
    "Clip": {
      "description": "A sliced segment of a media asset placed on the timeline.",
      "properties": {
        "clip_id": {
          "description": "Unique clip instance ID on the timeline",
          "title": "Clip Id",
          "type": "string"
        },
        "asset_id": {
          "description": "Referenced media asset ID in MediaPool",
          "title": "Asset Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "in_frame": {
          "default": 0,
          "description": "Source media in-point (start frame)",
          "minimum": 0,
          "title": "In Frame",
          "type": "integer"
        },
        "out_frame": {
          "description": "Source media out-point (end frame)",
          "exclusiveMinimum": 0,
          "title": "Out Frame",
          "type": "integer"
        },
        "timeline_start_frame": {
          "default": 0,
          "description": "Absolute frame on timeline",
          "minimum": 0,
          "title": "Timeline Start Frame",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "description": "Playback speed multiplier",
          "exclusiveMinimum": 0.0,
          "maximum": 32.0,
          "title": "Speed",
          "type": "number"
        },
        "reverse": {
          "default": false,
          "description": "Play clip in reverse",
          "title": "Reverse",
          "type": "boolean"
        },
        "fit_mode": {
          "default": "fit",
          "description": "Framing fit mode: fit, fill, stretch, center",
          "title": "Fit Mode",
          "type": "string"
        },
        "volume_db": {
          "default": 0.0,
          "maximum": 12.0,
          "minimum": -96.0,
          "title": "Volume Db",
          "type": "number"
        },
        "pan": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Pan",
          "type": "number"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorGradeConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transition_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transition_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        }
      },
      "required": [
        "clip_id",
        "asset_id",
        "out_frame"
      ],
      "title": "Clip",
      "type": "object"
    },
    "ColorGradeConfig": {
      "description": "Color grading pipeline configuration applied via FFmpeg eq / curves / lut3d.",
      "properties": {
        "exposure_ev": {
          "default": 0.0,
          "description": "Exposure bias in EV stops",
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Exposure Ev",
          "type": "number"
        },
        "contrast": {
          "default": 1.0,
          "description": "Contrast multiplier (1.0 = neutral)",
          "maximum": 3.0,
          "minimum": 0.0,
          "title": "Contrast",
          "type": "number"
        },
        "saturation": {
          "default": 1.0,
          "description": "Saturation multiplier (1.0 = neutral)",
          "maximum": 3.0,
          "minimum": 0.0,
          "title": "Saturation",
          "type": "number"
        },
        "temperature": {
          "default": 0.0,
          "description": "Color temp shift: blue (-) to orange (+)",
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Temperature",
          "type": "number"
        },
        "tint": {
          "default": 0.0,
          "description": "Tint shift: green (-) to magenta (+)",
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Tint",
          "type": "number"
        },
        "cdl": {
          "anyOf": [
            {
              "$ref": "#/$defs/ASC_CDL"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lift_gamma_gain": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiftGammaGain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lut_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to .cube or .3dl 3D LUT",
          "title": "Lut Path"
        },
        "lut_interpolation": {
          "$ref": "#/$defs/LUTInterpolation",
          "default": "tetrahedral"
        }
      },
      "title": "ColorGradeConfig",
      "type": "object"
    },
    "ContainerFormat": {
      "enum": [
        "mp4",
        "mov",
        "mkv",
        "webm",
        "wav",
        "mp3"
      ],
      "title": "ContainerFormat",
      "type": "string"
    },
    "DuckingConfig": {
      "description": "Sidechain ducking configuration for background music / ambiance tracks.",
      "properties": {
        "trigger_track_id": {
          "description": "Track ID whose presence attenuates this track (e.g. voiceover track)",
          "title": "Trigger Track Id",
          "type": "string"
        },
        "attenuation_db": {
          "default": -12.0,
          "description": "Volume attenuation in decibels when trigger track is active",
          "maximum": 0.0,
          "minimum": -48.0,
          "title": "Attenuation Db",
          "type": "number"
        },
        "attack_ms": {
          "default": 80.0,
          "description": "Time taken to lower volume once trigger starts (milliseconds)",
          "maximum": 2000.0,
          "minimum": 5.0,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 400.0,
          "description": "Time taken to restore volume after trigger ends (milliseconds)",
          "maximum": 5000.0,
          "minimum": 10.0,
          "title": "Release Ms",
          "type": "number"
        },
        "threshold_db": {
          "default": -26.0,
          "description": "Trigger audio detection threshold in dBFS",
          "maximum": 0.0,
          "minimum": -60.0,
          "title": "Threshold Db",
          "type": "number"
        }
      },
      "required": [
        "trigger_track_id"
      ],
      "title": "DuckingConfig",
      "type": "object"
    },
    "Effect": {
      "description": "Filter or DSP effect applied to a clip, track, or master output.",
      "properties": {
        "effect_id": {
          "description": "Unique effect identifier",
          "title": "Effect Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EffectKind",
          "description": "Category of filter / effect"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "parameters": {
          "additionalProperties": true,
          "description": "Filter-specific arguments",
          "title": "Parameters",
          "type": "object"
        },
        "keyframes": {
          "description": "Optional parameter keyframing",
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "effect_id",
        "kind"
      ],
      "title": "Effect",
      "type": "object"
    },
    "EffectKind": {
      "enum": [
        "color_grade",
        "lut3d",
        "gaussian_blur",
        "box_blur",
        "sharpen",
        "chroma_key",
        "denoise",
        "vignette",
        "custom_video_filter",
        "parametric_eq",
        "compressor",
        "limiter",
        "noise_gate",
        "loudnorm",
        "reverb",
        "custom_audio_filter"
      ],
      "title": "EffectKind",
      "type": "string"
    },
    "ExportPreset": {
      "description": "Specification for deterministic FFmpeg delivery encoding.",
      "properties": {
        "name": {
          "description": "Preset name, e.g. 'web_1080p', 'prores_422hq'",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "container": {
          "$ref": "#/$defs/ContainerFormat",
          "default": "mp4"
        },
        "video_codec": {
          "$ref": "#/$defs/VideoCodec",
          "default": "h264"
        },
        "audio_codec": {
          "$ref": "#/$defs/AudioCodec",
          "default": "aac"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "fps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "crf": {
          "anyOf": [
            {
              "maximum": 51,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 20,
          "title": "Crf"
        },
        "bitrate_kbps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bitrate Kbps"
        },
        "preset_speed": {
          "default": "medium",
          "description": "FFmpeg preset e.g. veryfast, medium, slow, p4",
          "title": "Preset Speed",
          "type": "string"
        },
        "pixel_format": {
          "default": "yuv420p",
          "title": "Pixel Format",
          "type": "string"
        },
        "audio_bitrate_kbps": {
          "default": 192,
          "exclusiveMinimum": 0,
          "title": "Audio Bitrate Kbps",
          "type": "integer"
        },
        "audio_sample_rate": {
          "default": 48000,
          "exclusiveMinimum": 0,
          "title": "Audio Sample Rate",
          "type": "integer"
        },
        "hwaccel": {
          "$ref": "#/$defs/HardwareAccel",
          "default": "auto"
        }
      },
      "required": [
        "name"
      ],
      "title": "ExportPreset",
      "type": "object"
    },
    "HardwareAccel": {
      "enum": [
        "auto",
        "none",
        "nvenc",
        "qsv",
        "videotoolbox",
        "amf",
        "vaapi"
      ],
      "title": "HardwareAccel",
      "type": "string"
    },
    "InterpolationMode": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out",
        "bezier",
        "hold"
      ],
      "title": "InterpolationMode",
      "type": "string"
    },
    "Keyframe": {
      "description": "A value keyframe along a clip or effect timeline.",
      "properties": {
        "frame": {
          "description": "Relative frame index from clip start",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "value": {
          "description": "Interpolated target value",
          "title": "Value",
          "type": "number"
        },
        "interpolation": {
          "$ref": "#/$defs/InterpolationMode",
          "default": "linear"
        },
        "bezier_handles": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cubic bezier control points (p1_x, p1_y, p2_x, p2_y)",
          "title": "Bezier Handles"
        }
      },
      "required": [
        "frame",
        "value"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "LUTInterpolation": {
      "enum": [
        "nearest",
        "trilinear",
        "tetrahedral"
      ],
      "title": "LUTInterpolation",
      "type": "string"
    },
    "LiftGammaGain": {
      "description": "Three-way color wheel adjustments.",
      "properties": {
        "lift": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "description": "Shadows (RGB)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lift",
          "type": "array"
        },
        "gamma": {
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "description": "Midtones (RGB)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Gamma",
          "type": "array"
        },
        "gain": {
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "description": "Highlights (RGB)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Gain",
          "type": "array"
        }
      },
      "title": "LiftGammaGain",
      "type": "object"
    },
    "LoudnessTarget": {
      "description": "EBU R128 / ITU-R BS.1770 broadcast and streaming loudness target.",
      "properties": {
        "target_i": {
          "default": -23.0,
          "description": "Integrated Loudness Target in LUFS (e.g. -23 for EBU, -14 for YouTube)",
          "title": "Target I",
          "type": "number"
        },
        "target_lra": {
          "default": 7.0,
          "description": "Loudness Range target in LU",
          "maximum": 50.0,
          "minimum": 1.0,
          "title": "Target Lra",
          "type": "number"
        },
        "target_tp": {
          "default": -1.0,
          "description": "Maximum True Peak in dBFS (typically -1.0 or -1.5)",
          "maximum": 0.0,
          "title": "Target Tp",
          "type": "number"
        }
      },
      "title": "LoudnessTarget",
      "type": "object"
    },
    "Marker": {
      "description": "Timeline temporal bookmark or note.",
      "properties": {
        "marker_id": {
          "title": "Marker Id",
          "type": "string"
        },
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "name": {
          "default": "Marker",
          "title": "Name",
          "type": "string"
        },
        "color": {
          "default": "#00FF00",
          "title": "Color",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        }
      },
      "required": [
        "marker_id",
        "frame"
      ],
      "title": "Marker",
      "type": "object"
    },
    "MediaAsset": {
      "description": "Registered media asset in the project media pool.",
      "properties": {
        "asset_id": {
          "description": "Unique alphanumeric identifier for the asset",
          "title": "Asset Id",
          "type": "string"
        },
        "file_path": {
          "description": "Absolute or project-relative file path",
          "title": "File Path",
          "type": "string"
        },
        "format_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Container format, e.g. mov,mp4,m4a,3gp,3g2,mj2",
          "title": "Format Name"
        },
        "duration_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "size_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "video_streams": {
          "items": {
            "$ref": "#/$defs/VideoStreamInfo"
          },
          "title": "Video Streams",
          "type": "array"
        },
        "audio_streams": {
          "items": {
            "$ref": "#/$defs/AudioStreamInfo"
          },
          "title": "Audio Streams",
          "type": "array"
        },
        "subtitle_streams": {
          "items": {
            "$ref": "#/$defs/SubtitleStreamInfo"
          },
          "title": "Subtitle Streams",
          "type": "array"
        },
        "hash_sha256": {
